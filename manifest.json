{
  "manifest_version": 3,
  "name": "Inbox & Drive Cleaner",
  "version": "1.1.0",
  "description": "Trash Gmail by your own rules (senders, categories, age, size) and move large Drive files to another Google account with free space.",
  "permissions": ["identity", "storage", "alarms", "notifications"],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Inbox & Drive Cleaner",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
